# Copy to .env and fill in. .env is git-ignored and must never be shared or zipped.
FRESHMEN_PUBLIC=1
FRESHMEN_API_KEY=
FRESHMEN_MODEL=gpt-5.6-luna
FRESHMEN_BASE_URL=https://hkust.azure-api.net/hkust-genai-auth/v1
# chats allowed per IP per window (seconds), and in total per day
FRESHMEN_PER_IP=30
FRESHMEN_WINDOW=600
FRESHMEN_DAILY=1000
# hours between automatic fetches of the official pages (0 = off)
FRESHMEN_REFRESH_HOURS=24
# set to 1 only when behind a proxy you control (Render/Railway/Cloudflare) so each visitor is limited separately
FRESHMEN_TRUST_PROXY=1
